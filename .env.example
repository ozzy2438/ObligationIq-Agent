# Azure identifiers; unused in dry_run/cached, required for live.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_REGION=
AZURE_AI_FOUNDRY_PROJECT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_CHEAP=
AZURE_OPENAI_DEPLOYMENT_STRONG=
AZURE_OPENAI_DEPLOYMENT_EMBED=

# Reserved for the later data plane; no Databricks connection in Phase 0.
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA_PREFIX=

# Optional local alternatives.
AZURE_AI_SEARCH_ENDPOINT=
AZURE_APIM_GATEWAY_URL=
AZURE_STORAGE_ACCOUNT=

# Live account identity for checking model/version/SKU before inference.
AZURE_OPENAI_ACCOUNT=
# Defaults: dry_run; false; 6 AUD lifetime; 1 AUD per UTC day.
LLM_MODE=
LLM_ALLOW_LIVE=
LLM_PROJECT_LIMIT_AUD=
LLM_DAILY_LIMIT_AUD=
# Defaults: .local/llm; 4096 input tokens; 1024 total output tokens.
LLM_STATE_DIR=
LLM_MAX_INPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
# Default 0; maximum 2. Only confirmed pre-dispatch failures are retryable.
LLM_MAX_RETRIES=
